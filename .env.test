# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'

# Pas de service Python pendant les tests : MoteurClient reste inactif (aucune requête réseau).
MOTEUR_URL=
MOTEUR_TOKEN=

# Les tests de sauvegarde écrivent dans un dossier à part (var/ est ignoré par git).
SAUVEGARDE_DIR=%kernel.project_dir%/var/sauvegardes_test
