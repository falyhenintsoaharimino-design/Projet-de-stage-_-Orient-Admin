+    /** Décision de l'agent sur un rendez-vous en attente : { "decision": "confirmer" | "refuser" } */
+    #[Route('/{id}/decision', name: 'api_rdv_decision', methods: ['PATCH'], requirements: ['id' => '\d+'])]
